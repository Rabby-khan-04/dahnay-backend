// DahNAY backend — Prisma schema for MongoDB
//
// Media model: the admin upload library. Admin panel uploads to ImageKit/S3,
// which returns a fileId + url. The url is stored in `src`, the ImageKit id
// in `fileId`. Deleting a library row means: look the row up by `src`,
// send its `fileId` to ImageKit, then delete the row.
//
// Content (solutions, articles, industries, page sections, seo) stores plain
// image URL strings — there are NO Prisma relations to Media. Reads resolve
// a URL to its library row via `src` (unique); writes accept any URL string,
// solution covers additionally require the URL to exist in the library.
//
// MongoDB notes:
//   * Prisma v7 does not support MongoDB yet — this project pins Prisma 6.19.
//   * Every document id maps to MongoDB's _id as an ObjectId.
//   * MongoDB needs a replica set for Prisma's nested writes/transactions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum SolutionKind {
  LOGISTICS
  LINES
  PORTS_INFRA
}

enum ArticleType {
  BLOG
  CASE_STUDY
  NEWS
}

enum ContactKind {
  PHONE
  EMAIL
}

enum AboutPageType {
  ABOUT
  ESG_CSR
  CAREERS
}

// ------------------------------------------------- embedded composite types

type LinkItem {
  label String
  href  String
}

type SeoFields {
  title       String?
  description String?
  canonical   String?
  robots      String?
  ogImageId   String? // image URL string (embedded — no relation possible)
}

type PostalAddress {
  street     String
  locality   String
  region     String
  postalCode String
  country    String
}

type ContactInfo {
  email     String
  phone     String?
  address   PostalAddress
  languages String[]
}

type SocialLinks {
  facebook  String?
  linkedin  String?
  instagram String?
  x         String?
}

type FooterColumn {
  heading String
  links   LinkItem[]
}

type FooterInfo {
  columns          FooterColumn[]
  popularLinksText String
  copyright        String
  legalLinks       LinkItem[]
  madeBy           String
}

type BrandInfo {
  name        String
  legalName   String
  tagline     String
  description String
  foundedYear Int
  founder     String
}

type Stat {
  value String
  label String
}

type PageCounter {
  count String
  title String
}

type PageBanner {
  image       String
  title       String
  description String
}

type PageOffer {
  title       String
  description String
  image       String?
  video       String?
}

type PageSolutions {
  title       String
  description String
}

type PageAboutUs {
  title       String
  description String
  video       String
  image       String
}

type PageInfo {
  title     String
  images    String[]
  bannerImg String
}

type PageCta {
  title     String
  bannerImg String
}

type AboutCounter {
  number String
  title  String
}

type AboutWhoWeAre {
  description String
  img         String
  counter     AboutCounter[]
}

type AboutWhyUs {
  title       String
  description String
  items       WhyUsItem[]
}

type AboutSocial {
  type String
  url  String
}

type AboutCeoInfo {
  name   String
  about  String
  image  String
  social AboutSocial[]
}

type AboutCta {
  title       String
  description String
  img         String
}

type AboutFaq {
  title       String
  description String
  faqs        FaqItem[]
}

type AboutInfoBlock {
  title       String
  description String
  image       String
}

type Feature {
  title       String
  description String
  img         String
}

type WhyUsItem {
  icon        String
  title       String
  description String
}

type WhyUsBlock {
  title String
  items WhyUsItem[]
}

type ExpertiseBlock {
  title       String
  description String?
  features    Feature[]
}

type FaqItem {
  question String
  answer   String
}

type SolutionOverview {
  title       String
  description String
  img         String
}

type SolutionServiceBlock {
  title       String
  description String
  services    Feature[]
}

type SolutionCertifications {
  title       String
  description String
  image       String
}

type SolutionFaq {
  title       String
  description String
  faqs        FaqItem[]
}

type IndustryOverview {
  title       String
  description String
}

type IndustryFaq {
  title       String
  description String
  qas         FaqItem[]
}

type OfficeContact {
  type  ContactKind
  value String
  href  String?
}

// --------------------------------------------------------------- models

/// Media library — admin uploads land here (ImageKit/S3 url in `src`,
/// provider id in `fileId`). Content references images by plain URL string.
model Media {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  src    String  @unique
  fileId String?
}

/// Real pages only (home, 3 solutions, 3 about, 3 newsroom, contact, industries).
/// Home + contact pages — one row per slug with fixed blocks.
/// Top-level image fields are plain URL strings (no relations).
model Page {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  slug      String         @unique
  bannerImg String?
  counter   PageCounter[]
  banner    PageBanner[]
  offer     PageOffer?
  solutions PageSolutions?
  aboutUs   PageAboutUs?
  whyUs     AboutWhyUs?
  info      PageInfo?
  cta       PageCta?
  faq       AboutFaq?
  status    ContentStatus  @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// About pages (about / esg-csr / careers) — one row per type, fixed shapes
/// per page instead of generic sections. Top-level image fields are plain
/// URL strings; covers must exist in Media (or arrive with a fileId
/// companion to register).
model AboutPage {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        AboutPageType    @unique
  slug        String           @unique
  image       String
  title       String?
  description String?
  whoWeAre    AboutWhoWeAre?
  whyUs       AboutWhyUs?
  ceoInfo     AboutCeoInfo?
  cta         AboutCta?
  faq         AboutFaq?
  infoBlock   AboutInfoBlock[]
  bannerImg   String?
  status      ContentStatus    @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

/// One data table for all solution kinds; listing pages filter by `kind`.
/// bannerImg is a plain URL string; covers must exist in Media (or arrive
/// with bannerImgFileId to register).
model Solution {
  id             String                  @id @default(auto()) @map("_id") @db.ObjectId
  kind           SolutionKind
  slug           String                  @unique
  name           String
  bannerImg      String
  overview       SolutionOverview?
  service        SolutionServiceBlock?
  experties      ExpertiseBlock?
  whyUs          WhyUsBlock?
  certifications SolutionCertifications?
  faq            SolutionFaq?
  status         ContentStatus           @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, slug])
  @@index([kind, status])
}

/// Blog / case-study / news posts; flat content rows resolved by (type, slug).
/// blogImg is a plain URL string; covers must exist in Media (or arrive
/// with blogImgFileId to register).
model Article {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  type        ArticleType
  slug        String
  title       String
  excerpt     String
  blogImg     String
  content     String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  industries  Industry[]    @relation("CaseStudy")

  @@unique([type, slug])
  @@index([type, publishedAt])
  @@index([type, status])
}

/// Office rows — fetched by the contact page's officeList block.
model Location {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  city      String
  country   String
  address   String
  contacts  OfficeContact[]
  status    ContentStatus   @default(DRAFT)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([country, sortOrder])
}

/// Industry rows — detail resolved by slug at /industries/{slug}.
model Industry {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  slug        String           @unique
  name        String
  bannerImg   String
  overview    IndustryOverview
  experties   ExpertiseBlock
  whyUs       WhyUsBlock
  faq         IndustryFaq
  caseStudyId String?          @db.ObjectId
  caseStudy   Article?         @relation("CaseStudy", fields: [caseStudyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

/// Singleton: brand, contact, socials, footer and default SEO — edit once.
model WebsiteInformation {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  brand       BrandInfo
  contact     ContactInfo
  social      SocialLinks
  footer      FooterInfo
  seoDefaults SeoFields
  updatedAt   DateTime    @updatedAt
}

/// Admin/dashboard users (cookie JWT auth).
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
